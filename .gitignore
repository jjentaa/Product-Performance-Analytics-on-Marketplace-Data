# ข้อมูลทั้งหมด ไม่เข้า git (ไฟล์ใหญ่ ใช้ HF เก็บแทน)
data/
*.duckdb
*.duckdb.wal

# ความลับ — ห้าม commit เด็ดขาด (token เก็บใน keyring ผ่าน huggingface-cli login)
.env
.env.*
*.token
secrets.yaml
# ยกเว้น template ที่ไม่มีค่าจริง — ต้อง commit เพื่อให้เพื่อนรู้ว่าต้องสร้างอะไร
!.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/
.idea/

# analytics/ — commit เฉพาะ analytics.ipynb และ Answer_Analytic.ipynb ที่เหลือไม่เข้า git
analytics/*
!analytics/analytics.ipynb
!analytics/Answer_Analytic.ipynb
