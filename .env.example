# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงลงไป — .env ถูก gitignore ไว้แล้ว
#
#   cp .env.example .env
#
# สร้าง token ที่ https://huggingface.co/settings/tokens (เลือก scope: write)
# huggingface_hub อ่านตัวแปรชื่อ HF_TOKEN นี้เองอัตโนมัติ ไม่ต้องส่งเข้าโค้ด
#
# อย่าวางค่า token จริงลงในแชท อีเมล หรือที่ไหนที่ไม่ใช่ไฟล์ .env นี้
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
